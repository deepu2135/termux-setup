#!/usr/bin/env bash
COLOR_FILE="${1:-/data/data/com.termux/files/home/.termux/colors.properties}"

if [ ! -f "$COLOR_FILE" ]; then
    if [ -f "$HOME/.termux/colors.properties" ]; then
        COLOR_FILE="$HOME/.termux/colors.properties"
    elif [ -f "/root/.termux/colors.properties" ]; then
        COLOR_FILE="/root/.termux/colors.properties"
    fi
fi

if [ -f "$COLOR_FILE" ]; then
    bg=$(grep "^background=" "$COLOR_FILE" | head -n 1 | cut -d= -f2 | tr -d ' \r\n')
    fg=$(grep "^foreground=" "$COLOR_FILE" | head -n 1 | cut -d= -f2 | tr -d ' \r\n')
    cur=$(grep "^cursor=" "$COLOR_FILE" | head -n 1 | cut -d= -f2 | tr -d ' \r\n')
    [ -n "$fg" ]  && printf "\033]10;%s\007" "$fg"
    [ -n "$bg" ]  && printf "\033]11;%s\007" "$bg"
    [ -n "$cur" ] && printf "\033]12;%s\007" "$cur"
    for i in {0..15}; do
        c=$(grep "^color$i=" "$COLOR_FILE" | head -n 1 | cut -d= -f2 | tr -d ' \r\n')
        [ -n "$c" ] && printf "\033]4;%d;%s\007" "$i" "$c"
    done
fi
