#!/usr/bin/env bash
CACHE_FILE="/tmp/.proot_storage_cache"

# Only update if cache is older than 10 minutes or missing
if [ ! -f "$CACHE_FILE" ] || [ $(($(date +%s) - $(stat -c %Y "$CACHE_FILE" 2>/dev/null || echo 0))) -gt 600 ]; then
    (
        home_kb=$(du -s "$HOME" 2>/dev/null | awk '{print $1}')
        pkg_mb=$(dpkg-query -W -f='${Installed-Size}\n' 2>/dev/null | awk '{s+=$1} END {print int(s/1024)}')
        
        home_gb=$(awk "BEGIN {printf \"%.1f\", ${home_kb:-1900000}/1048576}")
        total_gb=$(awk "BEGIN {printf \"%.1f\", (${home_kb:-1900000}/1048576) + (${pkg_mb:-2200}/1024) + 0.4}")
        
        echo "${home_gb} GiB (Home) | ${total_gb} GiB (Total)" > "$CACHE_FILE.tmp"
        mv "$CACHE_FILE.tmp" "$CACHE_FILE"
    ) &
fi
