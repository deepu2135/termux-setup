{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "builtin",
    "source": "ubuntu_small",
    "padding": {
      "top": 1,
      "left": 1,
      "right": 2
    }
  },
  "display": {
    "separator": " 󰄾 ",
    "color": {
      "separator": "cyan"
    }
  },
  "modules": [
    {
      "type": "title",
      "format": "{user-name-colored}{at-symbol-colored}{host-name-colored}"
    },
    {
      "type": "custom",
      "format": "──────────────────────────────"
    },
    {
      "type": "memory",
      "key": "   Memory",
      "keyColor": "green"
    },
    {
      "type": "command",
      "key": "  󰉉 Device Storage",
      "keyColor": "yellow",
      "text": "df -h /sdcard 2>/dev/null | awk 'NR==2 {print $3 \" / \" $2 \" (\" $4 \" free)\"}'"
    },
    {
      "type": "command",
      "key": "   PRoot Storage",
      "keyColor": "blue",
      "text": "cat /tmp/.proot_storage_cache 2>/dev/null || echo '1.9 GiB (Home) | 4.4 GiB (Total)'"
    },
    {
      "type": "custom",
      "format": "──────────────────────────────"
    },
    {
      "type": "colors",
      "symbol": "circle"
    }
  ]
}
